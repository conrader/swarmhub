#!/usr/bin/env python3
"""SwarmHub local control. JSON payloads are read from stdin, never shell-evaluated."""
import json
import os
import sys
sys.dont_write_bytecode = True
import swarm_control as control


def main(args):
    command, *args = args
    if command == "register":
        result = control.register(args[0], coordinator="--coordinator" in args[1:])
        start()
        return result
    if command == "policy":
        if args == ["set"]:
            result = control.publish(json.load(sys.stdin))
            start()
            return result
        return control.policy()
    if command == "submit":
        result = control.submit(json.load(sys.stdin))
        start()
        return result
    if command == "replace":
        result = control.replace(args[0], json.load(sys.stdin))
        start()
        return result
    if command == "stop":
        return control.stop(args[0])
    if command == "decide":
        if args[2] not in ("approve", "deny"):
            raise ValueError("choose approve or deny")
        control.decide(args[0], args[1], args[2] == "approve")
        start()
        return control.action(args[0])
    if command == "status":
        with control.database() as db:
            return {"actions": [dict(r) for r in db.execute("SELECT id,gate,status,error,decided_by,decided_at FROM actions")],
                    "deliveries": [dict(r) for r in db.execute("SELECT id,target,status,attempts,error FROM deliveries")]}
    if command == "report":
        sender, text = args
        targets = control.reporting_targets()
        ids = [control.enqueue(sender, target, text) for target in targets]
        start()
        return {"pending": ids, "targets": targets}
    if command == "enqueue":
        sender, target, task, text = args
        ident = control.enqueue(sender, target, text, task)
        start()
        return "pending:" + ident
    if command == "plan":
        return control.coding_plan(args[0], args[1] == "1")
    if command == "model":
        return control.coding_model(args[0])
    if command == "check-job":
        control.check_job(*args)
        return None
    if command == "webhook":
        # register/show/rotate print the URL and the key file path; the key itself is never printed.
        verb, *rest = args
        if verb == "register":
            result = control.webhook.register(rest[0], rest[1])
            start()
            return result
        if verb == "show":
            return control.webhook.show(rest[0], rest[1])
        if verb == "rotate":
            return control.webhook.rotate(rest[0], rest[1])
        if verb == "list":
            return control.webhook.listing()
        if verb == "fire":
            # Stdin JSON {"key": ..., "text": ...}: the key comes from the caller's copy, never from this box's file.
            payload = json.load(sys.stdin)
            if not isinstance(payload, dict):
                raise ValueError("webhook payload must be an object")
            try:
                result = control.webhook.fire(rest[0], rest[1], rest[2], payload.get("key", ""), payload.get("text", ""))
            except PermissionError:
                print("swarmctl: webhook rejected", file=sys.stderr)
                sys.exit(77)
            start()
            return result
        if verb == "serve":
            control.webhook.serve(int(rest[0]) if rest else control.webhook.DEFAULT_PORT)
            return None
        raise ValueError("webhook register|show|rotate|list|fire|serve")
    if command == "secret":
        verb, *rest = args
        if verb == "intake":
            return control.intake.intake(rest[0])  # Value on stdin; the printed record holds only the path.
        if verb == "list":
            return control.intake.listing()
        if verb == "remove":
            return control.intake.remove(rest[0])
        raise ValueError("secret intake|list|remove")
    if command == "active":
        if not control.active(args[0]):
            raise ValueError("task is stopped, denied, awaiting approval or FAKE")
        return None
    if command == "terminate":
        control.terminate(int(args[0]))
        return None
    if command == "run-action":
        control.run_action(args[0])
        return None
    if command == "tick":
        import runpy
        from pathlib import Path
        runpy.run_path(str(Path(__file__).with_name("peer-runtime.py")))["worker"](once=True)
        return None
    raise ValueError("unknown command")


def start():
    import runpy
    from pathlib import Path
    runpy.run_path(str(Path(__file__).with_name("peer-runtime.py")))["start_worker"]()


if __name__ == "__main__":
    os.umask(0o077)
    try:
        result = main(sys.argv[1:])
        if result is not None:
            print(result if isinstance(result, str) else json.dumps(result, sort_keys=True))
    except (ValueError, OSError, IndexError) as exc:
        print("swarmctl: " + str(exc), file=sys.stderr)
        sys.exit(64)

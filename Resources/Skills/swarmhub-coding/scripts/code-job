#!/bin/sh
# code-job: run one coding task with the first available coding agent, one of SLOTS jobs at a time on this box.
# Installed by SwarmHub with the swarmhub-coding skill. POSIX sh (dash, macOS sh); no flock/timeout/setsid.
#
#   code-job --bot <name> --order claude,codex,hermes [--origin <ordering-bot>] --model <id> --effort <level> --report <file> [--dir <workdir>] [--verify <command>] [--timeout <s>] [--max-turns <n>] -- "<task>"
#
# Exit: the agent's own code; 124 timeout; 75 + CODE_JOB_USE_DELEGATE on stdout when the order reaches hermes;
# 69 when every agent in the order was skipped; 65 empty work or no fresh report; 66 fresh report but no evidence
# (no new commit and no passing --verify command); 64 usage. Box-wide state lives in ~/.hermes/swarmhub/.

usage() { echo "usage: code-job --bot <name> --order claude,codex,hermes [--origin <ordering-bot>] --model <id> --effort <level> --report <file> [--dir <workdir>] [--verify <command>] [--timeout <s>] [--max-turns <n>] -- \"<task>\"" >&2; exit 64; }

BOT= ORDER= DIR=. TIMEOUT=1800 MAXTURNS=40 ORIGIN=${SWARMHUB_ORDERING_BOT:-}
MODEL=${CODE_JOB_MODEL:-} EFFORT=${CODE_JOB_EFFORT:-high} REPORT=${CODE_JOB_REPORT:-} TASKID= JOBID= SPECULATIVE=0
ORIGIN_GIVEN= VERIFY_ARG=
while [ $# -gt 0 ]; do
  case $1 in
    --bot|--order|--dir|--timeout|--max-turns|--origin|--model|--effort|--report|--task-id|--job-id|--verify)
      [ $# -ge 2 ] || usage
      case $1 in --bot) BOT=$2 ;; --order) ORDER=$2 ;; --dir) DIR=$2 ;; --timeout) TIMEOUT=$2 ;; --max-turns) MAXTURNS=$2 ;; --origin) ORIGIN=$2; ORIGIN_GIVEN=1 ;; --model) MODEL=$2 ;; --effort) EFFORT=$2 ;; --report) REPORT=$2 ;; --task-id) TASKID=$2 ;; --job-id) JOBID=$2 ;; --verify) VERIFY_ARG=$2 ;; esac
      shift 2 ;;
    --speculative) SPECULATIVE=1; shift ;;
    --) shift; break ;;
    *) usage ;;
  esac
done
[ $# -eq 1 ] && [ -n "$1" ] || usage
TASK=$1
if [ -z "$ORIGIN" ] && [ -z "$ORIGIN_GIVEN" ]; then
  case ${HERMES_SESSION_ID:-} in swarmhub-from-*) ORIGIN=${HERMES_SESSION_ID#swarmhub-from-} ;; esac
fi
case $BOT in ''|*[!A-Za-z0-9_.-]*) echo "code-job: --bot must be a bot name" >&2; exit 64 ;; esac
case $ORIGIN in *[!A-Za-z0-9_.-]*|.*) echo "code-job: --origin must be a bot name" >&2; exit 64 ;; esac
case $TIMEOUT in ''|*[!0-9]*|0) echo "code-job: --timeout must be a number of seconds" >&2; exit 64 ;; esac
case $MAXTURNS in ''|*[!0-9]*|0) echo "code-job: --max-turns must be a number" >&2; exit 64 ;; esac
[ -n "$ORDER" ] || usage
for a in $(echo "$ORDER" | tr ',' ' '); do
  case $a in claude|codex|hermes) ;; *) echo "code-job: unknown agent in --order: $a" >&2; exit 64 ;; esac
done
[ -d "$DIR" ] || { echo "code-job: no such directory: $DIR" >&2; exit 64; }
case $EFFORT in low|medium|high|xhigh) ;; *) usage ;; esac
case $MODEL in *[!A-Za-z0-9_./:-]*) usage ;; esac
case $TASKID in *[!A-Za-z0-9_.-]*|.*) usage ;; esac
case $JOBID in '') ;; job.*) case $JOBID in *[!A-Za-z0-9_.-]*) usage ;; esac ;; *) usage ;; esac
DIR=$(cd "$DIR" && pwd -P) || exit 64
case $REPORT in '') ;; /*) ;; *) REPORT=$DIR/$REPORT ;; esac
CTL=$(dirname "$0")/../../swarmhub-messages/scripts/swarmctl
# A managed task (--task-id) runs with the order/model its launcher resolved and recorded; policy is not
# re-applied mid-flight, so a policy change after launch cannot fail the job as a parameter mismatch.
if [ -f "$CTL" ]; then
  if [ -n "$TASKID" ]; then
    python3 "$CTL" check-job "$TASKID" "$BOT" "$DIR" "$MODEL" "$EFFORT" "$REPORT" "$TASK" "$ORDER" "$VERIFY_ARG" || exit 125
  else
    ORDER=$(python3 "$CTL" plan "$ORDER" "$SPECULATIVE") || exit 77
    MODEL=$(python3 "$CTL" model "$MODEL") || exit 77
  fi
fi
TASK=$(printf '%s\n\nWrite a fresh nonempty completion report to %s before finishing. Respect the task constraints, including any no-commit instruction. Completion requires an authorized new commit or a passing configured verification command; SwarmHub checks that evidence independently. Report accurately what you changed and checked.' "$TASK" "$REPORT")

# npm installs the CLIs into ~/.local (no root).
case :$PATH: in *":$HOME/.local/bin:"*) ;; *) PATH=$HOME/.local/bin:$PATH; export PATH ;; esac

S=$HOME/.hermes/swarmhub
umask 077
mkdir -p "$S/slots" && chmod 700 "$S" || exit 1
# Publish metadata before starting the CLI; finish publishes ready only after all fields exist.
mkdir -p "$S/job-completions" || exit 1
if [ -n "$JOBID" ]; then
  JOB=$S/job-completions/$JOBID
  mkdir "$JOB" || { echo "code-job: job already admitted: $JOBID" >&2; exit 73; }
else
  JOB=$(mktemp -d "$S/job-completions/job.XXXXXXXX") || exit 1
fi
printf '%s\n' "$BOT" > "$JOB/bot"
printf '%s\n' "$ORIGIN" > "$JOB/origin"
printf '%s\n' "$DIR" > "$JOB/directory"
printf '%s\n' "$MODEL" > "$JOB/model"
printf '%s\n' "$EFFORT" > "$JOB/effort"
printf '%s\n' "$REPORT" > "$JOB/report"
printf '%s\n' "$TASKID" > "$JOB/task-id"
printf '%s\n' "$$" > "$JOB/pid"
MSG=$(dirname "$0")/../../swarmhub-messages/scripts/bot-msg
SLOTS=$(sed -n 's/^SLOTS=\([0-9][0-9]*\)[[:space:]]*$/\1/p' "$S/coding.conf" 2>/dev/null | tail -n 1)
case $SLOTS in ''|0) SLOTS=1 ;; esac
# Verification command: --verify, else CODE_JOB_VERIFY, else VERIFY= in coding.conf (the box default). Run by code-job
# itself in --dir after the CLI exits 0; its exit code is evidence the model cannot write.
VERIFY=$VERIFY_ARG
if [ -z "$TASKID" ]; then
  VERIFY=${VERIFY_ARG:-${CODE_JOB_VERIFY:-}}
  [ -n "$VERIFY" ] || VERIFY=$(sed -n 's/^VERIFY=//p' "$S/coding.conf" 2>/dev/null | tail -n 1)
fi
VTIMEOUT=${CODE_JOB_VERIFY_TIMEOUT:-600}
case $VTIMEOUT in ''|*[!0-9]*|0) VTIMEOUT=600 ;; esac
printf '%s\n' "$VERIFY" > "$JOB/verify-command"
POLL=${CODE_JOB_POLL:-5}
# Launcher evidence (git-trust.json, verify-mode) lives where the coding CLI cannot write: under $S, outside --dir,
# /tmp and $TMPDIR, which codex's workspace-write sandbox allows. Only when --dir, /tmp or $TMPDIR contains $S (a HOME
# workspace) does it fall back to /tmp, and codex is then denied /tmp and $TMPDIR (NOTMP).
under() { case $1 in /) return 0 ;; esac; case $2/ in "$1"/*) return 0 ;; esac; return 1; }
mkdir -p "$S/scratch" || exit 1
# Best effort: only old entries with a definitely dead launcher are removed; uncertain/legacy entries stay.
python3 "$(dirname "$0")/scratch.py" "$S/scratch" || echo "code-job: scratch cleanup unavailable" >&2
T=$(mktemp -d "$S/scratch/code-job.$$.XXXXXX") || exit 1
trap 'rm -rf "$T"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
CANONICAL_T=$(cd "$T" && pwd -P) || exit 1
T=$CANONICAL_T
NOTMP=false
for d in /tmp "${TMPDIR:-/tmp}"; do
  d=$(cd "$d" 2>/dev/null && pwd -P) && under "$d" "$T" && NOTMP=true
done
if under "$DIR" "$T" || [ "$NOTMP" = true ]; then
  rm -rf "$T"; NOTMP=true
  T=$(mktemp -d "/tmp/code-job.XXXXXX") || exit 1
fi

SLOT= APID= MPID= VPID= O1= O2= AGENT=none SKIPPED= WAITED=0 RAN=0 PEAK=0 LOGGED=
HEAD_BEFORE= HEAD_AFTER=- COMMIT=not-checked VEXIT=- VMODE=- TESTS=not-run EVIDENCE=none

# Host git for evidence only, with the repository's executable settings overridden: even if an agent with a host
# shell planted core.fsmonitor or a hooks path in .git/config, code-job's own git never runs it.
HOSTGIT='git -c core.fsmonitor=false -c core.hooksPath=/dev/null'

# HEAD of --dir: a commit id, `none` (a repository without commits) or `not-a-repo`.
head_of() {
  if $HOSTGIT -C "$DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    $HOSTGIT -C "$DIR" rev-parse --verify HEAD 2>/dev/null || echo none
  else
    echo not-a-repo
  fi
}

# Evidence the CLI cannot write itself: a new HEAD since the baseline, and the configured verification command's exit.
# A configured command that fails is never outweighed by a commit. Only its exit is recorded, never its output.
collect_evidence() {
  HEAD_AFTER=$(head_of)
  COMMIT=false
  case $HEAD_AFTER in
    not-a-repo) COMMIT=not-a-repo ;;
    none) ;;
    *) if [ "$HEAD_AFTER" != "$HEAD_BEFORE" ]; then
         case $HEAD_BEFORE in none|not-a-repo) COMMIT=true ;;
           *) $HOSTGIT -C "$DIR" merge-base --is-ancestor "$HEAD_BEFORE" "$HEAD_AFTER" 2>/dev/null && COMMIT=true ;;
         esac
       fi ;;
  esac
  if [ -n "$VERIFY" ]; then
    # The launcher records its isolation mode (namespaced, fallback = limited, seatbelt) in $T, out of the verifier's reach.
    ( exec python3 "$(dirname "$0")/verify-sandbox.py" "$DIR" "$VERIFY" "$T/verify-mode" "$T/git-trust.json" ) < /dev/null > "$T/verify" 2>&1 &
    VPID=$!
    t0=$(date +%s); VEXIT=
    while kill -0 "$VPID" 2>/dev/null; do
      if [ -z "$VEXIT" ] && [ -n "$TASKID" ] && [ -f "$S/cancelled/$TASKID" ]; then VEXIT=125; kill_tree "$VPID"; fi
      if [ -z "$VEXIT" ] && [ $(( $(date +%s) - t0 )) -gt "$VTIMEOUT" ]; then VEXIT=124; kill_tree "$VPID"; fi
      sleep "${CODE_JOB_TICK:-1}"
    done
    wait "$VPID"; rc=$?
    VPID=
    [ -n "$VEXIT" ] || VEXIT=$rc
    TESTS=false; [ "$VEXIT" -eq 0 ] && TESTS=true
    case $(cat "$T/verify-mode" 2>/dev/null) in
      namespaced) VMODE=namespaced ;; fallback) VMODE=fallback ;; seatbelt) VMODE=seatbelt ;; *) VMODE=- ;;
    esac
    [ "$VMODE" = fallback ] && echo "code-job: verification ran in the limited sandbox (no user namespace); the result says so" >&2
  fi
  if [ "$TESTS" = true ] && [ "$COMMIT" = true ]; then EVIDENCE=commit+tests
  elif [ "$TESTS" = true ]; then EVIDENCE=tests
  elif [ "$COMMIT" = true ] && [ "$TESTS" = not-run ]; then EVIDENCE=commit
  else EVIDENCE=none; fi
}

# Every pid in the process tree under $1 (itself included), from one ps listing.
tree() {
  ps -A -o pid= -o ppid= 2>/dev/null | awk -v root="$1" '
    { kids[$2] = kids[$2] " " $1 }
    END { n = 1; q[1] = root; for (i = 1; i <= n; i++) { print q[i]; c = split(kids[q[i]], k, " "); for (j = 1; j <= c; j++) q[++n] = k[j] } }'
}

# Summed RSS (KB) of the tree under $1.
tree_rss() {
  ps -A -o pid= -o ppid= -o rss= 2>/dev/null | awk -v root="$1" '
    { kids[$2] = kids[$2] " " $1; rss[$1] = $3 }
    END { n = 1; q[1] = root; s = 0; for (i = 1; i <= n; i++) { s += rss[q[i]]; c = split(kids[q[i]], k, " "); for (j = 1; j <= c; j++) q[++n] = k[j] } print s + 0 }'
}

kill_tree() {
  [ -n "$1" ] || return 0
  pids=$(tree "$1")
  kill -TERM $pids 2>/dev/null
  sleep 1
  pids="$pids $(tree "$1")"
  kill -KILL $pids 2>/dev/null
  return 0
}

release() {
  if [ -n "$SLOT" ] && [ "$(cat "$SLOT/pid" 2>/dev/null)" = "$$" ]; then rm -rf "$SLOT"; fi
  SLOT=
}

# The last stderr line and the log line; never the task text or a token.
finish() {
  rc=$1 word=$2
  release
  printf '%s\n' "$AGENT" > "$JOB/agent"
  printf '%s\n' "$rc" > "$JOB/exit"
  [ -f "$JOB/cli-exit" ] || printf '%s\n' not-run > "$JOB/cli-exit"
  printf '%s\n' "$word" > "$JOB/status"
  printf '%s\n' "$WAITED" > "$JOB/waited"
  printf '%s\n' "$RAN" > "$JOB/ran"
  exists=false; [ -n "$REPORT" ] && [ -f "$REPORT" ] && exists=true
  printf '%s\n' "$exists" > "$JOB/report-exists"
  # The shell's view at finish, next to the contract's report-state at verify: tells an empty report from one
  # python3 could not stat, or one that appeared only after the check.
  final=missing
  if [ -n "$REPORT" ] && [ -f "$REPORT" ]; then final=empty; [ -s "$REPORT" ] && final=nonempty
  elif [ -n "$REPORT" ] && [ -e "$REPORT" ]; then final=not-regular; fi
  printf '%s\n' "$final" > "$JOB/report-final"
  printf '%s\n' "${HEAD_BEFORE:--}" > "$JOB/head-before"
  printf '%s\n' "$HEAD_AFTER" > "$JOB/head-after"
  printf '%s\n' "$COMMIT" > "$JOB/commit-evidence"
  printf '%s\n' "$VEXIT" > "$JOB/verify-exit"
  printf '%s\n' "$VMODE" > "$JOB/verify-mode"
  printf '%s\n' "$TESTS" > "$JOB/tests-passed"
  printf '%s\n' "$EVIDENCE" > "$JOB/evidence"
  : > "$JOB/ready"
  if [ -f "$MSG" ]; then
    /bin/sh "$MSG" --retry >/dev/null 2>&1 || echo "code-job: wake pending in $JOB" >&2
  else
    echo "code-job: wake pending in $JOB; install swarmhub-messages to deliver" >&2
  fi
  rm -rf "$T"
  sk=${SKIPPED#, }
  line="code-job: $AGENT $word · waited ${WAITED}s · ran ${RAN}s · peak $(( (PEAK + 1023) / 1024 )) MB"
  [ -n "$sk" ] && line="$line · skipped $sk"
  if [ -z "$LOGGED" ]; then
    LOGGED=1
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$BOT" "$AGENT" "$WAITED" "$RAN" \
      "$(( (PEAK + 1023) / 1024 ))" "$rc" "${sk:--}" >> "$S/coding-jobs.log"
    chmod 600 "$S/coding-jobs.log" 2>/dev/null
  fi
  echo "$line" >&2
  exit "$rc"
}

interrupted() {
  trap '' INT TERM
  kill_tree "$MPID"; kill_tree "$APID"; kill_tree "$VPID"
  [ -n "$O1" ] && kill "$O1" 2>/dev/null; [ -n "$O2" ] && kill "$O2" 2>/dev/null
  finish "$1" interrupted
}
trap 'release; rm -rf "$T"' EXIT
trap 'interrupted 130' INT
trap 'interrupted 143' TERM
trap 'interrupted 129' HUP

# Capture authority before any coding CLI can edit .git pointers; only a verification run uses it. A layout the
# verifier does not admit (submodule, separate-git-dir) is recorded as unsupported, so the job still runs and its
# verification refuses with that reason. A post-tool layout is never accepted instead. $T is outside the CLI's reach.
if [ -n "$VERIFY" ]; then
  python3 "$(dirname "$0")/verify-sandbox.py" --capture-git "$DIR" "$T/git-trust.json" || finish 77 failed
fi

# One of SLOTS slots: `mkdir slots/<i>.lock` is atomic. A lock whose pid is dead is stale; it is removed under a short
# reclaim guard so two waiters cannot both remove it (and so one cannot remove the other's fresh lock).
try_slot() {
  i=1
  while [ "$i" -le "$SLOTS" ]; do
    d=$S/slots/$i.lock
    if mkdir "$d" 2>/dev/null; then echo $$ > "$d/pid"; SLOT=$d; return 0; fi
    p=$(cat "$d/pid" 2>/dev/null)
    if [ -n "$p" ] && ! kill -0 "$p" 2>/dev/null && mkdir "$S/slots/reclaim" 2>/dev/null; then
      [ "$(cat "$d/pid" 2>/dev/null)" = "$p" ] && rm -rf "$d"
      rmdir "$S/slots/reclaim"
      continue
    fi
    i=$((i + 1))
  done
  return 1
}

take_slot() {
  [ -n "$SLOT" ] && return 0
  start=$(date +%s) said=
  until try_slot; do
    [ -n "$TASKID" ] && [ -f "$S/cancelled/$TASKID" ] && finish 125 cancelled
    if [ -z "$said" ]; then
      used=$(ls -d "$S"/slots/*.lock 2>/dev/null | wc -l | tr -d ' ')
      echo "Waiting for a free coding slot ($used in use)…" >&2; said=1
    fi
    # A reclaim guard left by a killed job would block reclaiming forever.
    [ -d "$S/slots/reclaim" ] && [ -n "$(find "$S/slots/reclaim" -prune -mmin +1 2>/dev/null)" ] && rmdir "$S/slots/reclaim" 2>/dev/null
    sleep "$POLL"
  done
  # A slot free at the first try is no wait (two clock reads can straddle a second).
  if [ -n "$said" ]; then WAITED=$(( $(date +%s) - start )); fi
}

# Runs agent $1 in --dir, streaming its stdout and stderr through; sets RC (124 on timeout) and copies output to $T/out.
run_agent() {
  rm -f "$T/o" "$T/e" "$T/timedout" "$T/peak"
  mkfifo "$T/o" "$T/e" || { RC=1; return; }
  : > "$T/out"; : > "$T/stdout"
  # $T/out is the combined transcript for diagnostics; $T/stdout alone decides whether the CLI produced work.
  tee -a "$T/out" "$T/stdout" < "$T/o" & O1=$!
  tee -a "$T/out" < "$T/e" >&2 & O2=$!
  (
    [ -n "$TASKID" ] && [ -f "$S/cancelled/$TASKID" ] && exit 125
    cd "$DIR" || exit 1
    unset ANTHROPIC_API_KEY
    SWARMHUB_REPORT_FILE=$REPORT; export SWARMHUB_REPORT_FILE
    case $1 in
      claude)
        if [ -f "$S/claude.token" ]; then CLAUDE_CODE_OAUTH_TOKEN=$(cat "$S/claude.token"); export CLAUDE_CODE_OAUTH_TOKEN; fi
        exec claude -p "$TASK" --permission-mode acceptEdits --allowedTools "Read,Edit,Write,Bash,Glob,Grep" \
          --model "$MODEL" --effort "$EFFORT" --max-turns "$MAXTURNS" --output-format text ;;
      # Config overrides instead of --full-auto: Codex CLI 0.159 dropped that flag (seen 2026-10-19); these keys exist in both.
      # With $T in /tmp (NOTMP), codex may not write /tmp or $TMPDIR, so it cannot rewrite the launcher evidence.
      codex) set --
        [ "$NOTMP" = true ] && set -- -c sandbox_workspace_write.exclude_slash_tmp=true -c sandbox_workspace_write.exclude_tmpdir_env_var=true
        exec codex exec --skip-git-repo-check -c 'sandbox_mode="workspace-write"' -c 'approval_policy="never"' "$@" \
          --model "$MODEL" -c "model_reasoning_effort=\"$EFFORT\"" "$TASK" ;;
    esac
  ) < /dev/null > "$T/o" 2> "$T/e" &
  APID=$!
  printf '%s\n' "$APID" > "$JOB/cli-pid"
  # Watchdog and sampler: every tick (1 s; CODE_JOB_TICK for tests) check the deadline (more than TIMEOUT whole seconds
  # on the clock), every 2 ticks add up the tree's RSS.
  (
    t=0 peak=0 t0=$(date +%s)
    while kill -0 "$APID" 2>/dev/null; do
      if [ -n "$TASKID" ] && [ -f "$S/cancelled/$TASKID" ]; then : > "$T/cancelled"; kill_tree "$APID"; break; fi
      if [ $((t % 2)) -eq 0 ]; then
        r=$(tree_rss "$APID"); [ "${r:-0}" -gt "$peak" ] && { peak=$r; echo "$peak" > "$T/peak"; }
      fi
      if [ $(( $(date +%s) - t0 )) -gt "$TIMEOUT" ]; then : > "$T/timedout"; kill_tree "$APID"; break; fi
      sleep "${CODE_JOB_TICK:-1}"; t=$((t + 1))
    done
  ) < /dev/null > /dev/null 2>&1 &
  MPID=$!
  ran0=$(date +%s)
  wait "$APID"; RC=$?
  RAN=$(( RAN + $(date +%s) - ran0 ))
  wait "$MPID" "$O1" "$O2"
  APID= MPID= O1= O2=
  p=$(cat "$T/peak" 2>/dev/null); [ "${p:-0}" -gt "$PEAK" ] && PEAK=$p
  [ -f "$T/timedout" ] && RC=124
  [ -f "$T/cancelled" ] && RC=125
}

# Only the CLI's own error output: the last 20 lines of a failed run (task output may mention limits or logins).
matches() { tail -n 20 "$T/out" | grep -Eiq "$1"; }

for a in $(echo "$ORDER" | tr ',' ' '); do
  [ -n "$TASKID" ] && [ -f "$S/cancelled/$TASKID" ] && finish 125 cancelled
  if [ -f "$CTL" ] && [ -z "$TASKID" ]; then
    allowed=$(python3 "$CTL" plan "$ORDER" "$SPECULATIVE") || finish 77 failed
    MODEL=$(python3 "$CTL" model "$MODEL") || finish 77 failed
    printf '%s\n' "$MODEL" > "$JOB/model"
    if [ "$allowed" = codex ] && [ "$a" != codex ]; then SKIPPED="$SKIPPED, $a: policy"; a=codex; fi
  fi
  if [ "$a" = hermes ]; then
    AGENT=hermes
    echo CODE_JOB_USE_DELEGATE
    finish 75 delegate
  fi
  # Claude Code runs on the host with the operator's shell (acceptEdits + Bash), not in a workspace sandbox. It is
  # therefore only ever started for a managed task whose owner-approved record check-job verified above; a direct
  # code-job skips it like a missing CLI so the order falls through to codex/hermes.
  if [ "$a" = claude ] && { [ -z "$TASKID" ] || [ ! -f "$CTL" ]; }; then SKIPPED="$SKIPPED, claude: approval"; continue; fi
  if ! command -v "$a" >/dev/null 2>&1; then SKIPPED="$SKIPPED, $a: missing"; continue; fi
  take_slot
  if [ -f "$CTL" ] && [ -z "$TASKID" ]; then
    allowed=$(python3 "$CTL" plan "$ORDER" "$SPECULATIVE") || finish 77 failed
    MODEL=$(python3 "$CTL" model "$MODEL") || finish 77 failed
    printf '%s\n' "$MODEL" > "$JOB/model"
    if [ "$allowed" = codex ] && [ "$a" != codex ]; then
      SKIPPED="$SKIPPED, $a: policy"; a=codex
      command -v codex >/dev/null 2>&1 || finish 69 failed
    fi
  fi
  AGENT=$a
  [ -n "$MODEL" ] && [ -n "$REPORT" ] || { echo "code-job: explicit --model and --report are required" >&2; finish 65 failed; }
  # macsmoke4: a report created by the tool was empty after a refused replacement on macOS.
  # Do not pre-create/remove a report or weaken exclusions: the latter protect launcher evidence.
  # This is a known-risk layout, not proof that every tool/write in it fails.
  if [ "$a" = codex ] && [ "$NOTMP" = true ] && [ "$(uname -s)" = Darwin ]; then
    for root in /tmp "${TMPDIR:-/tmp}"; do
      root=$(cd "$root" 2>/dev/null && pwd -P) || continue
      if under "$root" "$DIR"; then
        printf '%s\n' macos-excluded-tmp-workspace > "$JOB/sandbox-warning"
        echo "code-job: warning [macos-excluded-tmp-workspace]: --dir is under an excluded temporary root. Reports have been empty after refused Codex replacements here; completion will fail closed. Use HOME and --dir outside /tmp and \$TMPDIR to avoid this fallback." >&2
        break
      fi
    done
  fi
  # A pre-existing report cannot certify this run. Preserve it but require the CLI
  # to replace/change it; completion-contract.py hashes the baseline privately.
  python3 "$(dirname "$0")/completion-contract.py" baseline "$REPORT" "$JOB" || finish 65 failed
  HEAD_BEFORE=$(head_of)
  run_agent "$a"
  printf '%s\n' "$RC" > "$JOB/cli-exit"
  if [ "$RC" -eq 0 ]; then
    if python3 "$(dirname "$0")/completion-contract.py" verify "$REPORT" "$JOB" && [ -s "$T/stdout" ]; then
      collect_evidence
      [ "$VEXIT" = 125 ] && finish 125 cancelled
      python3 "$(dirname "$0")/completion-contract.py" verify "$REPORT" "$JOB" || finish 65 failed
      [ "$EVIDENCE" != none ] && finish 0 ok
      echo "code-job: unverified: fresh report but no new commit and no passing verification (verify exit $VEXIT)" >&2
      finish 66 unverified
    fi
    echo "code-job: empty job or missing/empty/unchanged report" >&2
    if [ -f "$JOB/sandbox-warning" ] && [ "$(cat "$JOB/report-valid" 2>/dev/null)" = false ]; then
      echo 'code-job: report failure [macos-excluded-tmp-workspace]: see report-state; move HOME and --dir outside temporary roots and rerun.' >&2
      finish 65 report-failed-macos-excluded-tmp-workspace
    fi
    finish 65 failed
  fi
  [ "$RC" -eq 125 ] && finish 125 cancelled
  [ "$RC" -eq 124 ] && finish 124 timeout
  if [ "$a" = claude ]; then
    login='Invalid API key|Please run /login|not logged in'
    limit='usage limit reached|Claude AI usage limit|rate_limit_error'
  else
    login='Not logged in|codex login'
    limit='usage_limit_reached|You.ve hit your usage limit|rate_limit_exceeded'
  fi
  if matches "$login"; then SKIPPED="$SKIPPED, $a: login"; AGENT=none; continue; fi
  if matches "$limit"; then SKIPPED="$SKIPPED, $a: limit"; AGENT=none; continue; fi
  finish "$RC" failed
done
echo "code-job: no coding agent in --order $ORDER could run" >&2
finish 69 failed

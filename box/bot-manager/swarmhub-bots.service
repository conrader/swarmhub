[Unit]
Description=SwarmHub bots route (P22): lists bots, reads instructions, hands a new bot's key to SwarmHub once
After=network.target hermes.service

[Service]
User=hermes
Group=hermes
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B /opt/swarmhub-bots/server.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/hermes/.hermes/swarmhub
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=64M

[Install]
WantedBy=multi-user.target
